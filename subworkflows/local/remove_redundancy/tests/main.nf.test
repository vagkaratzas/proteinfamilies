    test("faa - dotted sample id - skip_sequence_redundancy_removal - skip_family_merging") {
        // Regression test for family file names being cut at their first dot. Sample ids may
        // contain dots, so 'chunk.v2_3.hmm.gz' must resolve to family 'chunk.v2_3', not 'chunk':
        // otherwise FILTER_NON_REDUNDANT_* keeps the redundant family and the chunk-key split
        // fails. Same fixtures as the non-dotted test of this configuration, renamed, with the
        // HMM NAME fields rewritten to match; chunk_3 is the redundant family there.
        when {
            workflow {
                """
                def sample = 'chunk.v2'
                def fixture = { name -> file(params.pipelines_testdata_base_path + "test_data/subworkflows/\${name}", checkIfExists: true) }
                def renamed = { ext ->
                    (1..3).collect { n ->
                        def f = file("\${sample}_\${n}.\${ext}")
                        if (ext == 'hmm.gz') {
                            def text = new java.util.zip.GZIPInputStream(fixture.call("chunk_\${n}.\${ext}").newInputStream()).text
                            new java.util.zip.GZIPOutputStream(f.newOutputStream()).withWriter { writer ->
                                writer << text.replaceAll(/(?m)^NAME  chunk_/, "NAME  \${sample}_")
                            }
                        } else {
                            fixture.call("chunk_\${n}.\${ext}").copyTo(f)
                        }
                        [ [ id: sample, chunk: n ], f ]
                    }
                }

                input[0] = channel.of([
                    [ id: sample ],
                    file(params.pipelines_testdata_base_path + 'test_data/mgnifams_input_small.faa', checkIfExists: true)
                ])
                input[1] = channel.fromList(renamed.call('clipkit'))
                input[2] = channel.fromList(renamed.call('sto.gz'))
                input[3] = channel.fromList(renamed.call('faa.gz'))
                input[4] = channel.fromList(renamed.call('hmm.gz'))
                input[5]  = false      // skip_family_redundancy_removal
                input[6]  = true       // skip_family_merging
                input[7]  = 0.1        // hmmsearch_family_redundancy_length_threshold
                input[8]  = 0.9        // hmmsearch_family_similarity_length_threshold
                input[9]  = true       // skip_sequence_redundancy_removal
                input[10] = "linclust" // clustering_tool
                input[11] = "standard" // family_generation_algorithm
                input[12] = "famsa"    // alignment_tool
                input[13] = false      // skip_msa_trimming
                input[14] = "clipkit"  // clipkit_out_format
                input[15] = false      // hmmsearch_write_target
                input[16] = true       // hmmsearch_write_domain
                input[17] = false      // skip_additional_sequence_recruiting
                input[18] = 0.9        // hmmsearch_query_length_threshold
                """
            }
        }

        then {
            assertAll(
                // Pre-fix, splitting 'chunk' on 'chunk.v2_' found no chunk suffix and failed
                { assert workflow.success },
                // Redundant family 3 is dropped, as in the non-dotted test, and chunk keys keep
                // the dotted sample id intact
                { assert workflow.out.fasta.collect { meta, _f -> [ meta.id, meta.chunk ] }.sort() == [ ['chunk.v2', '1'], ['chunk.v2', '2'] ] },
                { assert workflow.out.full_msa.collect { meta, _f -> [ meta.id, meta.chunk ] }.sort() == [ ['chunk.v2', '1'], ['chunk.v2', '2'] ] }
            )
        }
    }
}
